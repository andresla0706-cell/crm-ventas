# Copia este archivo como .env (o configura estas variables en Railway).

# Puerto del servidor (Railway lo define solo).
PORT=3000

# Carpeta donde vive la base de datos SQLite. En Railway monta un volumen en /data.
DATA_DIR=/data

# Usuario administrador que se crea la primera vez que arranca (si no hay usuarios).
ADMIN_USER=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=cambia-esta-clave

# Clave para el webhook POST /api/webhooks/leads?key=... (n8n u otras herramientas). Vacío = webhook apagado.
WEBHOOK_KEY=

# Sincronización automática con Meta Lead Ads (opcional).
# Token de usuario del sistema con permiso leads_retrieval sobre la página.
META_ACCESS_TOKEN=
# IDs de formularios instantáneos separados por coma.
META_FORM_IDS=
# Cada cuántos minutos revisar (por defecto 5).
META_POLL_MINUTES=5

# Zona horaria para fechas en el historial.
TZ=America/Bogota
